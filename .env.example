# ========================================================
# SPACES PLATFORM CONFIGURATION
# ========================================================

# Instance Operational Mode: family | team | public | mixed
INSTANCE_MODE=mixed

# Environment: development | production | test
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=Spaces
APP_URL=http://localhost:3000

# Security & Secrets (CHANGE IN PRODUCTION!)
JWT_ACCESS_SECRET=spaces_super_secure_access_secret_change_me_in_prod_1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=spaces_super_secure_refresh_secret_change_me_in_prod_0987654321
JWT_REFRESH_EXPIRES_IN=30d

# PostgreSQL Database
DATABASE_URL=postgresql://spaces_admin:spaces_secret_pass_2026@localhost:5432/spaces_db?schema=public
POSTGRES_USER=spaces_admin
POSTGRES_PASSWORD=spaces_secret_pass_2026
POSTGRES_DB=spaces_db
POSTGRES_PORT=5432

# Redis Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO S3-Compatible Object Storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_PORT=9000
S3_REGION=us-east-1
S3_ACCESS_KEY=spaces_minio_admin
S3_SECRET_KEY=spaces_minio_secret_key_2026
S3_BUCKET_NAME=spaces-media
S3_FORCE_PATH_STYLE=true

# MinIO Console
MINIO_CONSOLE_PORT=9001

# Firebase Cloud Messaging (Push Notifications)
# Paste JSON service account as one-line string or point to file
FIREBASE_SERVICE_ACCOUNT_KEY=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

